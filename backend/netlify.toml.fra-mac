[build]
  publish = "public"
  functions = "netlify/functions"

# De planlagte job (vagt, dagvagt, seovagt, ryd, ugemail, sorovagt, postkasse) har deres tidsplan i
# netlify/functions/<navn>.mjs (export const config), fordi funktionerne bruger Netlifys nye format.
[functions]
  node_bundler = "esbuild"

# oppetidsvagten, hver time

# ugemailen, mandag kl. 06:00 UTC, altsaa 08:00 dansk sommertid
# dagvagten, hver morgen kl. 07:00 UTC. Opdager om maalingen er doed.

# seo-hjulet, mandag kl. 05:00 UTC, foer ugemailen

# oprydning af persondata, hver nat kl. 03:00 UTC


# nye blogindlaeg fra Soros RSS-feed, hver time ti minutter over

# Panelet er én side. Alt arbejde sker i funktionen bagved.
# egen besoegstaeller, siden sender hertil
# den gamle adresse sender videre til backend.voreshjem.dk, undtagen taelleren,
# som gamle kopier af hentknap.js stadig kan sende til
[[redirects]]
  from = "https://voreshjem-backend.netlify.app/t"
  to   = "https://voreshjem-backend.netlify.app/.netlify/functions/taeller"
  status = 200
  force = true

[[redirects]]
  from = "https://voreshjem-backend.netlify.app/*"
  to   = "https://backend.voreshjem.dk/:splat"
  status = 301
  force = true

# Den tyske backends netlify.app-adresse: panelet sendes videre til domaenet (fund L125, 16. okt. 2026).
# Kun selve siden, saa webhooks fra Apple og Google, taelleren og /api stadig virker paa den gamle adresse.
[[redirects]]
  from = "https://unserzuhause-backend.netlify.app/"
  to   = "https://backend.unserzuhauseapp.de/"
  status = 301
  force = true

[[redirects]]
  from = "https://unserzuhause-backend.netlify.app/index.html"
  to   = "https://backend.unserzuhauseapp.de/"
  status = 301
  force = true

[[redirects]]
  from = "/t"
  to   = "/.netlify/functions/taeller"
  status = 200

[[redirects]]
  from = "/api/*"
  to   = "/.netlify/functions/admin/:splat"
  status = 200

# Soro og andre skrivende tjenester rammer denne adresse
[[redirects]]
  from = "/webhook/*"
  to   = "/.netlify/functions/webhook/:splat"
  status = 200

# Kontaktformularen paa voreshjem.dk
[[redirects]]
  from = "/formular/kontakt"
  to   = "/.netlify/functions/kontakt"
  status = 200

# Panelet viser kundesager og chats. CSP er sikkerhedsnettet, hvis en senere aendring glemmer at escape.
# Skriften (/fonts) og QR-biblioteket (/qrcode.min.js, qrcodejs 1.0.0 fra cdnjs, sha512 tjekket 11. okt. 2026)
# ligger lokalt, saa panelet henter intet udefra.
[[headers]]
  for = "/*"
  [headers.values]
    X-Frame-Options = "DENY"
    X-Content-Type-Options = "nosniff"
    Referrer-Policy = "same-origin"
    Cache-Control = "no-cache"
    Content-Security-Policy = "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    Permissions-Policy = "camera=(), microphone=(), geolocation=(), payment=()"
